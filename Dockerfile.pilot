# INDEPENDENT STAGING PILOT ONLY. Never publish an image containing customer data.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install --no-install-recommends -y tesseract-ocr && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY scripts ./scripts
COPY data ./data
COPY README.md ./README.md
# Mounted persistent pilot storage is created/configured outside this container.
RUN mkdir -p /app/pilot_data && useradd --system --uid 10001 --home /app pilot
RUN chown -R 10001:10001 /app/pilot_data
USER 10001
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
